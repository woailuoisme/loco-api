# Server
PORT=5150
BINDING=localhost
LOG_LEVEL=debug
HOST=http://localhost:5150

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/loco_api_development

# Queue & Cache (Valkey / Redis)
REDIS_URL=redis://:redis_secret@127.0.0.1:6379

# Mailer (Mailpit / SMTP)
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USER=mailpit
MAILER_PASSWORD=mailpit

# Authentication (JWT Secret - required in production)
JWT_SECRET=replace-with-a-secure-random-secret
