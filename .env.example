# Loco 环境变量示例，复制为 .env 后填入实际值: cp .env.example .env
LOCO_ENV=development
APP_NAME=loco-api

# 应用 (APP_*)
APP_PORT=5150
APP_BINDING=localhost
APP_URL=http://localhost

# 数据库 (DB_*，Docker 内部用容器名如 @postgres:5432)
DB_URL=postgres://postgres:password@localhost:5432/loco_api_development
DB_URL_TEST=postgres://postgres:password@localhost:5432/loco_api_test

# Google OAuth2 / One Tap
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 缓存 (CACHE_*，Docker 内部用容器名如 @valkey:6379)
CACHE_URL=redis://127.0.0.1:6379/1
CACHE_MAX_SIZE=10

# 消息队列 (REDIS_URL)
REDIS_URL=redis://127.0.0.1:6379/0

# 对象存储 (AWS_*，兼容 Garage / MinIO / S3)
AWS_BUCKET=default
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://localhost:3900
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# 认证 (JWT_*)
JWT_SECRET=YOUR_JWT_SECRET_64_HEX_CHARS
JWT_TTL=604800

# 邮件 (MAIL_*)
MAIL_HOST=localhost
MAIL_PORT=1025

# 实时通讯 (CENTRIFUGO_*，Docker 内部用 @centrifugo:8000/api，本地开发用 48000)
CENTRIFUGO_API_ENDPOINT=http://127.0.0.1:48000/api
CENTRIFUGO_WS_URL=ws://localhost:48000/connection/websocket
CENTRIFUGO_API_KEY=YOUR_CENTRIFUGO_API_KEY
CENTRIFUGO_TOKEN_HMAC_SECRET=YOUR_CENTRIFUGO_TOKEN_HMAC_SECRET
CENTRIFUGO_TOKEN_AUDIENCE=centrifugo
CENTRIFUGO_TOKEN_TTL_SECS=86400

# OpenTelemetry 遥测三位一体 (Logs, Metrics, Traces)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=loco-api
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORT_TIMEOUT_SECS=3

